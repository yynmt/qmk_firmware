{
  "keyboard_name": "Acperience70",
  "manufacturer": "yynmt",
  "url": "http://yynmt.com",
  "maintainer": "yynmt",

  "processor": "atmega32u4",
  "bootloader": "atmel-dfu",

  "features": {
      "bootmagic": true,
      "command": false,
      "console": false,
      "extrakey": true,
      "mousekey": true,
      "nkro": true
  },

  "usb": {
      "vid": "0x04D8",
      "pid": "0xEA50",
      "device_version": "1.1.0"
  },

  "diode_direction": "COL2ROW",
  "matrix_pins": {
      "cols": ["F7", "C7", "C6", "B6", "B5", "B4", "D7", "D6", "D4"],
      "rows": ["F0", "F1", "F4", "F5", "F6"]
  },

  "debounce": 50,

  "split": {
    "enabled" : true,
    "transport": {
      "protocol": "serial"
    },
    "soft_serial_pin" : "D2"
  },

  "layouts": {
    "LAYOUT": {
      "layout": [
        {"matrix": [0, 0], "x":0, "y":0, "label":"Esc"},
        {"matrix": [0, 1], "x":1, "y":0, "label":"1"},
        {"matrix": [0, 2], "x":2, "y":0, "label":"2"},
        {"matrix": [0, 3], "x":3, "y":0, "label":"3"},
        {"matrix": [0, 4], "x":4, "y":0, "label":"4"},
        {"matrix": [0, 5], "x":5, "y":0, "label":"5"},

        {"matrix": [5, 0], "x": 7.75, "y":0, "label":"6"},
        {"matrix": [5, 1], "x": 8.75, "y":0, "label":"7"},
        {"matrix": [5, 2], "x": 9.75, "y":0, "label":"8"},
        {"matrix": [5, 3], "x":10.75, "y":0, "label":"9"},
        {"matrix": [5, 4], "x":11.75, "y":0, "label":"0"},
        {"matrix": [5, 5], "x":12.75, "y":0, "label":"-"},
        {"matrix": [5, 6], "x":13.75, "y":0, "label":"="},
        {"matrix": [5, 7], "x":14.75, "y":0, "label":"Backspace"},
        {"matrix": [5, 8], "x":16.75, "y":0, "label":"Pg Up"},

        {"matrix": [1, 0], "x":0,   "y":1, "label":"Tab"},
        {"matrix": [1, 1], "x":1.5, "y":1, "label":"Q"},
        {"matrix": [1, 2], "x":2.5, "y":1, "label":"W"},
        {"matrix": [1, 3], "x":3.5, "y":1, "label":"E"},
        {"matrix": [1, 4], "x":4.5, "y":1, "label":"R"},
        {"matrix": [1, 5], "x":5.5, "y":1, "label":"T"},

        {"matrix": [6, 0], "x": 8.25, "y":1, "label":"Y"},
        {"matrix": [6, 1], "x": 9.25, "y":1, "label":"U"},
        {"matrix": [6, 2], "x":10.25, "y":1, "label":"I"},
        {"matrix": [6, 3], "x":11.25, "y":1, "label":"O"},
        {"matrix": [6, 4], "x":12.25, "y":1, "label":"P"},
        {"matrix": [6, 5], "x":13.25, "y":1, "label":"["},
        {"matrix": [6, 6], "x":14.25, "y":1, "label":"]"},
        {"matrix": [6, 7], "x":15.25, "y":1, "label":"Backslash"},
        {"matrix": [6, 8], "x":16.75, "y":1, "label":"Pg Dn"},

        {"matrix": [2, 0], "x":0,    "y":2, "label":"Caps Lock"},
        {"matrix": [2, 1], "x":1.75, "y":2, "label":"A"},
        {"matrix": [2, 2], "x":2.75, "y":2, "label":"S"},
        {"matrix": [2, 3], "x":3.75, "y":2, "label":"D"},
        {"matrix": [2, 4], "x":4.75, "y":2, "label":"F"},
        {"matrix": [2, 5], "x":5.75, "y":2, "label":"G"},

        {"matrix": [7, 0], "x": 8.5,  "y":2, "label":"H"},
        {"matrix": [7, 1], "x": 9.5,  "y":2, "label":"J"},
        {"matrix": [7, 2], "x":10.5,  "y":2, "label":"K"},
        {"matrix": [7, 3], "x":11.5,  "y":2, "label":"L"},
        {"matrix": [7, 4], "x":12.5,  "y":2, "label":";"},
        {"matrix": [7, 5], "x":13.5,  "y":2, "label":"'"},
        {"matrix": [7, 7], "x":14.5,  "y":2, "label":"Enter"},
        {"matrix": [7, 8], "x":16.75, "y":2, "label":"Home"},

        {"matrix": [3, 0], "x":0,    "y":3, "label":"Shift"},
        {"matrix": [3, 1], "x":2.25, "y":3, "label":"Z"},
        {"matrix": [3, 2], "x":3.25, "y":3, "label":"X"},
        {"matrix": [3, 3], "x":4.25, "y":3, "label":"C"},
        {"matrix": [3, 4], "x":5.25, "y":3, "label":"V"},
        {"matrix": [3, 5], "x":6.25, "y":3, "label":"B"},

        {"matrix": [8, 0], "x":9,     "y":3, "label":"N"},
        {"matrix": [8, 1], "x":10,    "y":3, "label":"M"},
        {"matrix": [8, 2], "x":11,    "y":3, "label":","},
        {"matrix": [8, 3], "x":12,    "y":3, "label":"."},
        {"matrix": [8, 4], "x":13,    "y":3, "label":"/"},
        {"matrix": [8, 5], "x":14,    "y":3, "label":"Shift"},
        {"matrix": [8, 7], "x":15.75, "y":3, "label":"Up"},
        {"matrix": [8, 8], "x":16.75, "y":3, "label":"End"},

        {"matrix": [4, 0], "x":0,    "y":4, "label":"Ctrl"},
        {"matrix": [4, 1], "x":1.25, "y":4, "label":"Win"},
        {"matrix": [4, 2], "x":2.5,  "y":4, "label":"Alt"},
        {"matrix": [4, 3], "x":3.75, "y":4, "label":"Fn"},
        {"matrix": [4, 4], "x":5,    "y":4, "label":"Space"},

        {"matrix": [9,0], "x":9.5,   "y":4, "label":"Space"},
        {"matrix": [9,3], "x":11.75, "y":4, "label":"Fn"},
        {"matrix": [9,4], "x":13,    "y":4, "label":"Ctrl"},
        {"matrix": [9,5], "x":14.75, "y":4, "label":"Left"},
        {"matrix": [9,7], "x":15.75, "y":4, "label":"Down"},
        {"matrix": [9,8], "x":16.75, "y":4, "label":"Right"}
      ]
    }
  }
}
