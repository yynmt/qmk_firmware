{
  "keyboard_name": "Cochlea",
  "manufacturer": "yynmt",
  "url": "https://yynmt.com",
  "maintainer": "yynmt",
  "usb": {
    "device_version": "1.0.0",
    "vid": "0x04D8",
    "pid": "0xE5F7"
  },

  "features": {
    "bootmagic": true,
    "command": false,
    "console": false,
    "extrakey": true,
    "mousekey": true,
    "nkro": true
  },

  "processor": "atmega32u2",
  "bootloader": "atmel-dfu",
  "diode_direction": "COL2ROW",
  "matrix_pins": {
    "direct": [
      ["C5", "NO_PIN", "NO_PIN"]
    ]
  },

  "encoder": {
    "rotary": [
      {"pin_a": "B1", "pin_b": "B0", "resolution": 4}
    ]
  },

  "layouts": {
    "LAYOUT": {
      "layout": [
        {"matrix": [0, 1], "x":0, "y":0},
        {"matrix": [0, 2], "x":1, "y":0},
        {"matrix": [0, 0], "x":0.5, "y":1}
      ]
    }
  }
}
