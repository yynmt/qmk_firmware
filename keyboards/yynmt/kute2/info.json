{
    "keyboard_name": "Kute2",
    "manufacturer": "yynmt",
    "url": "http://yynmt.com",
    "maintainer": "yynmt",

    "usb": {
        "device_version": "1.0.0",
        "pid": "0x097E",
        "vid": "0x2E8A"
    },

    "processor": "RP2040",
    "bootloader": "rp2040",

    "features": {
        "bootmagic": false,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": true
    },

    "matrix_pins": {
        "direct": [
            ["GP18", "GP19", "GP20", "GP6", "GP3", "GP4", "GP5"]
        ]
    },

    "rgblight": {
        "led_count": 18,
        "sleep": true,
        "animations": {
            "alternating": true,
            "breathing": true,
            "christmas": false,
            "knight": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "rgb_test": false,
            "snake": true,
            "static_gradient": true,
            "twinkle": false
        },
        "hue_steps": 4,
        "saturation_steps": 8,
        "brightness_steps": 8,
        "max_brightness": 247,
        "driver": "ws2812"
    },
    "ws2812": {
      "pin": "GP17"
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0,    "y": 0, "label": "C0"},
                {"matrix": [0, 1], "x": 0.75, "y": 0, "label": "C1"},
                {"matrix": [0, 2], "x": 1.5,  "y": 0, "label": "C2"},
                {"matrix": [0, 4], "x": 3,    "y": 0, "label": "C3"},
                {"matrix": [0, 5], "x": 3.75, "y": 0, "label": "C4"},
                {"matrix": [0, 6], "x": 4.5,  "y": 0, "label": "C5"},

                {"matrix": [0, 3], "x": 0,    "y": 0.75, "label": "BS"}
            ]
        }
    }
}
